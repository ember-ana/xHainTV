/* Custom CSS Sample
 *
 * Change color and fonts here.
 *
 * Beware that properties cannot be unitless, so for example write '--gap-body: 0px;' instead of just '--gap-body: 0;'
 */

/* Uncomment and adjust accordingly if you want to import another font from the google-fonts-api: */
/* @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@100;300;400;700&display=swap'); */

:root {
  --color-text: #999;
  --color-text-callout: #ccc;
  --color-text-dimmed: #aed919;
  --color-text-bright: #fff;
  --color-background: #000;
  --color-background-callout: #1a1a1a;

  --font-primary: "Roboto Condensed";
  --font-secondary: "Roboto";

  --font-size: 30px;
  --font-size-small: 1.0rem;

  --gap-body-top: 20px;
  --gap-body-right: 20px;
  --gap-body-bottom: 20px;
  --gap-body-left: 20px;

  --gap-modules: 30px;
}

.region.middle.center {
  .module.calendar tr.event-wrapper.event {
    > td.title {
      text-align: left;
    }
    &.today {
      background-color: var(--color-background-callout);

      > td.symbol,
      > td.time {
        color: var(--color-text-callout);
      }
      > td.title {
        font-weight: 600;
      }
    }
  }
}

